# ==========================================================
# TAKE coffee&more — Loyalty System — Environment Configuration
# Copy this file to ".env" and fill in real values before running.
# ==========================================================

# --- Telegram Bot ---
# Obtained from @BotFather when you create your bot.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# Public @username of your bot (no @), used to build deep links.
BOT_USERNAME=take_loyalty_bot

# --- Database ---
# Async Postgres DSN. Works with Supabase / Neon.tech / local Postgres.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/take_loyalty

# --- Security ---
# Secret used to sign/verify the QR payload HMAC token. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
QR_SECRET_KEY=replace_with_a_long_random_hex_string

# Barista scanner screen PIN (numeric string). Change this before going live.
BARISTA_PIN=1234

# Max age (seconds) that Telegram initData is considered fresh. Telegram
# recommends rejecting anything older than this to prevent replay attacks.
INIT_DATA_MAX_AGE_SECONDS=86400

# --- App / Business Rules ---
APP_NAME=TAKE coffee&more Loyalty
CASHBACK_RATE=0.03
DEFAULT_BRANCH_ID=1
DEFAULT_BRANCH_NAME=TAKE #1
DEFAULT_BRANCH_ADDRESS=Central Branch

# --- Web ---
# Public HTTPS base URL where this app is deployed (required by Telegram
# WebApps — Telegram will only open https:// URLs inside the client).
BASE_URL=https://your-domain.example.com

# Set to "true" while developing locally without a real Telegram initData
# payload. NEVER set this to true in production — it disables signature
# verification and accepts a debug user.
DEV_MODE=false
